/******************************************************************************
 CMain.c

				CMain Document Class

	Generated by Visual Architect - extended by Pit Förster with Claude Code via AppleBridge
	(2026-10-27): MacNetScan 2, phase 2 - the window and the engine's loop.

	Layout (window 720 x 460): the tool strip 0..48 (Scan, Stop, Export,
	Copy, the view tabs, the ACT LED), the view 48..436, the status bar
	436..460. Every pane is enclosed by the WINDOW: Visual Architect's main
	pane keeps its template size and is hidden.

	The engine (netcore.c, Segment 34, plain C) is driven by CNetChore from
	the idle loop: one bounded slice per call, so WaitNextEvent keeps running
	and the AppleBridge daemon - and every other process - keeps its time.

	The source is plain ASCII; characters outside it are MacRoman escapes.

 ******************************************************************************/

#include "CMain.h"
#include "AppCommands.h"
#include "netcore.h"

#include <CApplication.h>
#include <CBartender.h>
#include <Commands.h>
#include <CPicture.h>
#include <CScrollPane.h>
#include <CStaticText.h>
#include <CWindow.h>

#include <Errors.h>
#include <Files.h>
#include <Memory.h>
#include <Scrap.h>
#include <StandardFile.h>
#include <Script.h>

extern	CApplication	*gApplication;
extern	CBartender		*gBartender;

#include "Look.h"

/******************************************************************************
 CStripPane - the dark tool strip

 ******************************************************************************/

CStripPane::CStripPane(CView *anEnclosure, CBureaucrat *aSupervisor, short aWidth, short aHeight)
	: CPane(anEnclosure, aSupervisor, aWidth, aHeight, 0, 0, sizELASTIC, sizFIXEDTOP)
{
}

void CStripPane::Draw(Rect *area)
{
	Rect r;

	TextMode(srcOr);								/* text over the pane's own colour, no white box */
	FrameToQDR(&frame, &r);
	RGBForeColor(&kStrip);
	PaintRect(&r);
	RGBForeColor(&kStripLine);
	MoveTo(r.left, (short) (r.bottom - 1));
	LineTo(r.right, (short) (r.bottom - 1));
	TextFont(kGeneva); TextSize(9); TextFace(normal);
	RGBForeColor(&kStripText);
	MoveTo((short) (r.right - 58), 40);
	DrawC("ACT");
	RGBForeColor(&kBlackC);
}

/******************************************************************************
 CToolButton

 ******************************************************************************/

CToolButton::CToolButton(CView *anEnclosure, CBureaucrat *aSupervisor, short aHEncl, short aVEncl,
						 const char *aLabel, short anIcon, long aCommand)
	: CPane(anEnclosure, aSupervisor, 56, 44, aHEncl, aVEncl, sizFIXEDLEFT, sizFIXEDTOP)
{
	CToPStr(aLabel, label);
	icon = anIcon;
	command = aCommand;
	active = TRUE;
	SetWantsClicks(TRUE);
}

void CToolButton::SetActive(Boolean anActive)
{
	if (anActive == active) return;
	active = anActive;
	Prepare();
	DrawButton(FALSE);
}

void CToolButton::Draw(Rect *area)
{
	DrawButton(FALSE);
}

void CToolButton::DrawButton(Boolean pressed)
{
	Rect r, k;
	PolyHandle p;
	short cx, w;

	TextMode(srcOr);
	FrameToQDR(&frame, &r);
	RGBForeColor(&kStrip);
	PaintRect(&r);
	if (pressed) {
		k = r; InsetRect(&k, 2, 2);
		RGBForeColor(&kBtnDown);
		PaintRoundRect(&k, 8, 8);
	}
	cx = (short) ((r.left + r.right) / 2);
	SetRect(&k, (short) (cx - 9), (short) (r.top + 6), (short) (cx + 9), (short) (r.top + 24));
	switch (icon) {
		case kIconScan:												/* a play triangle			*/
			RGBForeColor(active ? &kGo : &kDimIcon);
			p = OpenPoly();
			MoveTo((short) (k.left + 2), k.top);
			LineTo((short) (k.right + 1), (short) ((k.top + k.bottom) / 2));
			LineTo((short) (k.left + 2), k.bottom);
			LineTo((short) (k.left + 2), k.top);
			ClosePoly();
			PaintPoly(p);
			KillPoly(p);
			break;
		case kIconStop:												/* a stop square			*/
			RGBForeColor(active ? &kHalt : &kDimIcon);
			InsetRect(&k, 2, 2);
			PaintRoundRect(&k, 4, 4);
			break;
		case kIconExport:											/* a page with an arrow out	*/
			RGBForeColor(active ? &kIconLight : &kDimIcon);
			PenSize(2, 2);
			SetRect(&k, (short) (cx - 8), (short) (r.top + 9), (short) (cx + 4), (short) (r.top + 25));
			FrameRect(&k);
			MoveTo((short) (cx - 2), (short) (r.top + 16));
			LineTo((short) (cx + 9), (short) (r.top + 7));
			MoveTo((short) (cx + 3), (short) (r.top + 6));
			LineTo((short) (cx + 9), (short) (r.top + 6));
			LineTo((short) (cx + 9), (short) (r.top + 12));
			PenNormal();
			break;
		case kIconCopy:												/* two pages				*/
			RGBForeColor(active ? &kIconLight : &kDimIcon);
			PenSize(2, 2);
			SetRect(&k, (short) (cx - 9), (short) (r.top + 6), (short) (cx + 3), (short) (r.top + 20));
			FrameRect(&k);
			OffsetRect(&k, 6, 5);
			RGBForeColor(pressed ? &kBtnDown : &kStrip);
			PaintRect(&k);
			RGBForeColor(active ? &kIconLight : &kDimIcon);
			FrameRect(&k);
			PenNormal();
			break;
	}
	TextFont(kGeneva); TextSize(9); TextFace(normal);
	RGBForeColor(active ? &kStripText : &kDimIcon);
	w = StringWidth(label);
	MoveTo((short) (cx - w / 2), (short) (r.bottom - 6));
	DrawString(label);
	RGBForeColor(&kBlackC);
}

void CToolButton::DoClick(Point hitPt, short modifierKeys, long when)
{
	Rect r;
	Point pt;
	Boolean in = TRUE, was;

	if (!active) return;
	Prepare();
	FrameToQDR(&frame, &r);
	DrawButton(TRUE);
	while (StillDown()) {
		GetMouse(&pt);
		was = in;
		in = PtInRect(pt, &r);
		if (in != was) DrawButton(in);
	}
	DrawButton(FALSE);
	if (in && itsSupervisor != NULL) itsSupervisor->DoCommand(command);
}

/******************************************************************************
 CTabBar - IP Network | AppleTalk | Listen | Tools

 ******************************************************************************/

CTabBar::CTabBar(CView *anEnclosure, CBureaucrat *aSupervisor, short aWidth, short aHEncl, short aVEncl)
	: CPane(anEnclosure, aSupervisor, aWidth, 24, aHEncl, aVEncl, sizFIXEDLEFT, sizFIXEDTOP)
{
	current = kViewIP;
	SetWantsClicks(TRUE);
}

void CTabBar::SetCurrent(short aView)
{
	if (aView == current) return;
	current = aView;
	Prepare();
	Draw(NULL);
}

void CTabBar::Draw(Rect *area)
{
	Rect r, s;
	short i, w, seg;

	TextMode(srcOr);								/* text over the pane's own colour, no white box */

	FrameToQDR(&frame, &r);
	RGBForeColor(&kTabOff);
	PaintRoundRect(&r, 10, 10);
	seg = (short) ((r.right - r.left) / kViewCount);
	TextFont(kGeneva); TextSize(10); TextFace(bold);
	for (i = 0; i < kViewCount; i++) {
		SetRect(&s, (short) (r.left + i * seg), r.top, (short) (r.left + (i + 1) * seg), r.bottom);
		if (i == current) {
			RGBForeColor(&kAccent);
			if (i == 0 || i == kViewCount - 1) PaintRoundRect(&s, 10, 10);
			else PaintRect(&s);
			if (i == 0) { Rect q = s; q.left = (short) (q.left + seg / 2); PaintRect(&q); }
			if (i == kViewCount - 1) { Rect q = s; q.right = (short) (q.right - seg / 2); PaintRect(&q); }
		} else if (i > 0 && i != current + 1) {
			RGBForeColor(&kStripLine);
			MoveTo(s.left, (short) (s.top + 5));
			LineTo(s.left, (short) (s.bottom - 6));
		}
		RGBForeColor(i == current ? &kWhiteC : &kStripText);
		w = WidthC(kViewName[i]);
		MoveTo((short) ((s.left + s.right - w) / 2), (short) (s.bottom - 8));
		DrawC(kViewName[i]);
	}
	TextFace(normal);
	RGBForeColor(&kBlackC);
}

void CTabBar::DoClick(Point hitPt, short modifierKeys, long when)
{
	Rect r;
	short i;
	FrameToQDR(&frame, &r);
	i = (short) ((hitPt.h - r.left) * kViewCount / (r.right - r.left));
	if (i < 0 || i >= kViewCount) return;
	if (itsSupervisor != NULL) itsSupervisor->DoCommand(cmdViewIP + i);
}

/******************************************************************************
 CLedPane

 ******************************************************************************/

CLedPane::CLedPane(CView *anEnclosure, CBureaucrat *aSupervisor, short aSize, short aHEncl, short aVEncl,
				   const RGBColor *aColour)
	: CPane(anEnclosure, aSupervisor, aSize, aSize, aHEncl, aVEncl, sizFIXEDRIGHT, sizFIXEDTOP)
{
	colour = *aColour;
	lit = FALSE;
}

void CLedPane::SetLit(Boolean aLit)
{
	if (aLit == lit) return;
	lit = aLit;
	Prepare();
	Draw(NULL);
}

void CLedPane::Draw(Rect *area)
{
	Rect r;
	FrameToQDR(&frame, &r);
	RGBForeColor(&kStrip);
	PaintRect(&r);
	DrawLed(&r, &colour, lit);
}

/******************************************************************************
 CListHeader - the table's column titles

 ******************************************************************************/

CListHeader::CListHeader(CView *anEnclosure, CBureaucrat *aSupervisor, short aWidth, short aHEncl, short aVEncl)
	: CPane(anEnclosure, aSupervisor, aWidth, kHeaderHeight, aHEncl, aVEncl, sizFIXEDLEFT, sizFIXEDTOP)
{
}

void CListHeader::Draw(Rect *area)
{
	Rect r;
	short i, w;
	const char *nm;
	const RGBColor *c;

	TextMode(srcOr);
	FrameToQDR(&frame, &r);
	RGBForeColor(&kHeaderBg);
	PaintRect(&r);
	RGBForeColor(&kStatusLn);
	MoveTo(r.left, (short) (r.bottom - 1));
	LineTo(r.right, (short) (r.bottom - 1));
	TextFont(kGeneva); TextSize(9); TextFace(bold);
	RGBForeColor(&kInkSoft);
	MoveTo((short) (r.left + kColAddr), (short) (r.top + 15)); DrawC("Address");
	MoveTo((short) (r.left + kColName), (short) (r.top + 15)); DrawC("Name");
	MoveTo((short) (r.left + kColRtt), (short) (r.top + 15)); DrawC("RTT");
	TextFace(condense);								/* three letters in 20 pixels	*/
	for (i = 0; i < NC_PortCount() && i < 10; i++) {
		SvcFor(i, &nm, &c);
		w = WidthC(nm);
		MoveTo((short) (r.left + kColSvc + i * kSvcPitch + 6 - w / 2), (short) (r.top + 15));
		DrawC(nm);
	}
	RGBForeColor(&kBlackC);
}

/******************************************************************************
 CHostList - the table

 ******************************************************************************/

CHostList::CHostList(CView *anEnclosure, CBureaucrat *aSupervisor, short aWidth, short aHeight)
	: CPanorama(anEnclosure, aSupervisor, aWidth, aHeight, 0, 0, sizELASTIC, sizELASTIC)
{
	rows = 0;
	selIP = 0;
	SetScales(1, kRowHeight);						/* scrolls a row at a time		*/
	SetWantsClicks(TRUE);
	Update();
}

void CHostList::Update()
{
	LongRect b;
	short w, h;
	rows = NC_HostCount();
	GetLengths(&w, &h);
	b.left = 0; b.top = 0; b.right = w; b.bottom = rows;
	SetBounds(&b);
	if (itsScrollPane != NULL) itsScrollPane->AdjustScrollMax();
	Refresh();
}

void CHostList::Draw(Rect *area)
{
	LongRect lr;
	Rect r, k, cut;
	char s[32], ip[20];
	short i, p, y;
	const char *nm;
	const RGBColor *c;

	TextMode(srcOr);
	RGBForeColor(&kWhiteC);
	PaintRect(area);
	TextFont(kGeneva); TextSize(9); TextFace(normal);
	for (i = 0; i < rows && i < NC_HostCount(); i++) {
		const NCHost *h = NC_Host(i);
		GetLengths(&p, &y);
		lr.top = (long) i * kRowHeight; lr.bottom = lr.top + kRowHeight;
		lr.left = 0; lr.right = p;
		FrameToQDR(&lr, &r);
		if (!SectRect(&r, area, &cut)) continue;
		if (h->ip == selIP) { RGBForeColor(&kSelRow); PaintRect(&r); }
		else if (i & 1) { RGBForeColor(&kRowAlt); PaintRect(&r); }
		y = (short) (r.top + 13);
		SetRect(&k, (short) (r.left + kColLed), (short) (r.top + 4), (short) (r.left + kColLed + 10), (short) (r.top + 14));
		DrawLed(&k, &kAlive, TRUE);
		RGBForeColor(&kInk);
		TextFont(kMonaco);
		NC_IPToStr(h->ip, ip);
		MoveTo((short) (r.left + kColAddr), y); DrawC(ip);
		TextFont(kGeneva);
		MoveTo((short) (r.left + kColName), y);
		if (h->name[0] && h->name[0] != '?') DrawTrunc(h->name, kColRtt - kColName - 8);
		else { RGBForeColor(&kInkSoft); DrawC(h->name[0] == '?' ? "-" : "\xC9"); RGBForeColor(&kInk); }
		DrawRtt((short) (r.left + kColRtt), (short) (r.top + 13), h->rttUs);
		s[0] = '\0'; NC_RttToStr(h->rttUs, s);
		RGBForeColor(&kInkSoft);
		MoveTo((short) (r.left + kColRtt + 22), y); DrawC(s);
		for (p = 0; p < NC_PortCount() && p < 10; p++) {
			SvcFor(p, &nm, &c);
			SetRect(&k, (short) (r.left + kColSvc + p * kSvcPitch), (short) (r.top + 3),
					(short) (r.left + kColSvc + p * kSvcPitch + 12), (short) (r.top + 15));
			DrawLed(&k, c, (Boolean) ((h->openMask & (1UL << p)) != 0));
		}
	}
	RGBForeColor(&kBlackC);
}

void CHostList::DoClick(Point hitPt, short modifierKeys, long when)
{
	short i = (short) (hitPt.v / kRowHeight);
	unsigned long ip = 0;
	if (i >= 0 && i < rows && i < NC_HostCount()) ip = NC_Host(i)->ip;
	if (ip == selIP) return;
	selIP = ip;
	Refresh();
	if (itsSupervisor != NULL) ((CMain *) itsSupervisor)->HostSelected(ip);
}

/******************************************************************************
 CDetailPane - the selected host

 ******************************************************************************/

CDetailPane::CDetailPane(CView *anEnclosure, CBureaucrat *aSupervisor, short aWidth, short aHeight,
						 short aHEncl, short aVEncl)
	: CPane(anEnclosure, aSupervisor, aWidth, aHeight, aHEncl, aVEncl, sizFIXEDRIGHT, sizELASTIC)
{
	ip = 0;
}

void CDetailPane::SetHost(unsigned long anIP)
{
	ip = anIP;
	Refresh();
}

void CDetailPane::Draw(Rect *area)
{
	Rect r, k;
	char s[64], ipS[20];
	short p, x, y;
	const char *nm;
	const RGBColor *c;
	const NCHost *h = ip != 0 ? HostByIP(ip) : NULL;

	TextMode(srcOr);
	FrameToQDR(&frame, &r);
	RGBForeColor(&kDetailBg);
	PaintRect(&r);
	RGBForeColor(&kStatusLn);
	MoveTo(r.left, r.top);
	LineTo(r.left, r.bottom);
	x = (short) (r.left + 14);
	if (h == NULL) {
		TextFont(kGeneva); TextSize(9);
		RGBForeColor(&kInkSoft);
		MoveTo(x, (short) (r.top + 28));
		DrawC("Select a host to see its services.");
		RGBForeColor(&kBlackC);
		return;
	}
	TextFont(kChicago); TextSize(12);
	RGBForeColor(&kInk);
	MoveTo(x, (short) (r.top + 26));
	DrawTrunc(h->name[0] && h->name[0] != '?' ? h->name : "(no name)", r.right - x - 10);
	TextFont(kMonaco); TextSize(9);
	NC_IPToStr(h->ip, ipS);
	MoveTo(x, (short) (r.top + 42)); DrawC(ipS);
	TextFont(kGeneva); TextSize(9);
	RGBForeColor(&kInkSoft);
	s[0] = '\0';
	CCat(s, h->nameSource == 'N' ? "Name from NetBIOS" : h->nameSource == 'M' ? "Name from multicast DNS" :
			h->nameSource == 'D' ? "Name from DNS" : "No name answered");
	MoveTo(x, (short) (r.top + 58)); DrawC(s);
	DrawRtt(x, (short) (r.top + 78), h->rttUs);
	s[0] = '\0'; CCat(s, "Round trip "); NC_RttToStr(h->rttUs, s + CLen(s)); if (h->rttUs >= 0) CCat(s, " ms");
	RGBForeColor(&kInk);
	MoveTo((short) (x + 26), (short) (r.top + 78)); DrawC(s);

	TextFace(bold);
	MoveTo(x, (short) (r.top + 104)); DrawC("Services");
	TextFace(normal);
	y = (short) (r.top + 122);
	for (p = 0; p < NC_PortCount(); p++, y += 18) {
		Boolean open = (Boolean) ((h->openMask & (1UL << p)) != 0);
		SvcFor(p, &nm, &c);
		SetRect(&k, x, (short) (y - 10), (short) (x + 12), (short) (y + 2));
		DrawLed(&k, c, open);
		s[0] = '\0'; NC_PortLabel(p, s); CCat(s, "  "); CCatNum(s, NC_Port(p));
		RGBForeColor(open ? &kInk : &kInkSoft);
		MoveTo((short) (x + 20), y); DrawC(s);
		MoveTo((short) (r.right - 46), y); DrawC(open ? "open" : "-");
	}
	RGBForeColor(&kBlackC);
}

/******************************************************************************
 CStatusBar

 ******************************************************************************/

CStatusBar::CStatusBar(CView *anEnclosure, CBureaucrat *aSupervisor, short aWidth, short aHEncl, short aVEncl)
	: CPane(anEnclosure, aSupervisor, aWidth, kStatusHeight, aHEncl, aVEncl, sizELASTIC, sizFIXEDBOTTOM)
{
	text[0] = '\0';
	counts[0] = '\0';
	done = total = 0;
}

void CStatusBar::SetState(const char *aText, long aDone, long aTotal, const char *aCounts)
{
	short i;
	for (i = 0; aText[i] != '\0' && i < 95; i++) text[i] = aText[i];
	text[i] = '\0';
	for (i = 0; aCounts[i] != '\0' && i < 63; i++) counts[i] = aCounts[i];
	counts[i] = '\0';
	done = aDone;
	total = aTotal;
	Prepare();
	Draw(NULL);
}

void CStatusBar::DrawProgress()
{
	Rect r, t, seg;
	short x, filled, cells, i;

	FrameToQDR(&frame, &r);
	SetRect(&t, (short) (r.left + 300), (short) (r.top + 8), (short) (r.left + 462), (short) (r.top + 18));
	RGBForeColor(&kBarTrack);
	PaintRoundRect(&t, 4, 4);
	if (total <= 0) return;
	cells = 20;											/* segmented: 20 cells of 7 + 1	*/
	filled = (short) (done >= total ? cells : done * cells / total);
	for (i = 0; i < filled; i++) {
		x = (short) (t.left + 1 + i * 8);
		SetRect(&seg, x, (short) (t.top + 1), (short) (x + 7), (short) (t.bottom - 1));
		RGBForeColor(&kBarFill);
		PaintRect(&seg);
	}
}

void CStatusBar::Draw(Rect *area)
{
	Rect r;
	short w;

	TextMode(srcOr);								/* text over the pane's own colour, no white box */

	FrameToQDR(&frame, &r);
	RGBForeColor(&kStatusBg);
	PaintRect(&r);
	RGBForeColor(&kStatusLn);
	MoveTo(r.left, r.top);
	LineTo(r.right, r.top);
	TextFont(kGeneva); TextSize(9); TextFace(normal);
	RGBForeColor(&kInk);
	MoveTo((short) (r.left + 10), (short) (r.top + 16));
	DrawC(text);
	DrawProgress();
	RGBForeColor(&kInk);
	w = WidthC(counts);
	MoveTo((short) (r.right - 12 - w), (short) (r.top + 16));
	DrawC(counts);
	RGBForeColor(&kBlackC);
}

/******************************************************************************
 CNetChore

 ******************************************************************************/

void CNetChore::Perform(long *maxSleep)
{
	if (itsMain != NULL) itsMain->Pump(maxSleep);
}


TCL_DEFINE_CLASS_M1(CMain, x_CMain);

/**** C O N S T R U C T I O N / D E S T R U C T I O N   M E T H O D S ****/


void CMain::ICMain()

{
	strip = NULL;
	scanBtn = stopBtn = exportBtn = copyBtn = NULL;
	tabs = NULL;
	actLed = NULL;
	atPane = NULL;
	atScroll = NULL;
	listenPane = NULL;
	toolsPane = NULL;
	hostField = NULL;
	pingBtn = dnsBtn = traceBtn = NULL;
	toolMode = 0;
	lastToolSig = -1;
	lastEvents = -1;
	listHeader = NULL;
	listScroll = NULL;
	hostList = NULL;
	detail = NULL;
	status = NULL;
	chore = NULL;
	view = kViewIP;
	netOK = FALSE;
	stage = 0;
	lastChange = -1;
	lastActivity = 0;
	ledOff = 0;
	lastStatus = 0;
	lastDraw = 0;

	Ix_CMain();
}


/******************************************************************************
 MakeNewWindow {OVERRIDE}

	Everything is enclosed by the WINDOW, not by itsMainPane: Visual
	Architect's view keeps its template size and its two template panes.

 ******************************************************************************/

void CMain::MakeNewWindow()

{
	Rect sr;

	x_CMain::MakeNewWindow();
	if (fMain_Pict1 != NULL) fMain_Pict1->Hide();
	if (fMain_Stat2 != NULL) fMain_Stat2->Hide();
	SetRect(&sr, 560, 300, 1024, 768);
	itsWindow->SetSizeRect(&sr);
	itsWindow->ChangeSize(kWinWidth, kWinHeight);
	itsWindow->SetTitle("\pMacNetScan");

	strip = new CStripPane(itsWindow, this, kWinWidth, kStripHeight);
	scanBtn = new CToolButton(itsWindow, this, 8, 2, "Scan", kIconScan, cmdScanStart);
	stopBtn = new CToolButton(itsWindow, this, 64, 2, "Stop", kIconStop, cmdScanStop);
	exportBtn = new CToolButton(itsWindow, this, 128, 2, "Export", kIconExport, cmdExport);
	copyBtn = new CToolButton(itsWindow, this, 184, 2, "Copy", kIconCopy, cmdCopyReport);
	tabs = new CTabBar(itsWindow, this, 408, 246, 12);			/* six views: 68 px a tab */
	actLed = new CLedPane(itsWindow, this, 16, kWinWidth - 52, 12, &kLedAct);
	{															/* the other views, hidden	*/
		short h = kWinHeight - kStripHeight - kStatusHeight;
		atScroll = new CScrollPane(itsWindow, this, kWinWidth, h, 0, kStripHeight,
								   sizFIXEDLEFT, sizFIXEDTOP, FALSE, TRUE, FALSE);
		atPane = new CATPane(atScroll, this, kWinWidth - 15, h, 0, 0);
		atScroll->InstallPanorama(atPane);
		atScroll->Hide();
		listenPane = new CListenPane(itsWindow, this, kWinWidth, h, 0, kStripHeight);
		listenPane->Hide();
		mapPane = new CMapPane(itsWindow, this, kWinWidth, h, 0, kStripHeight);
		mapPane->Hide();
		framesPane = new CFramesPane(itsWindow, this, kWinWidth, h, 0, kStripHeight);	/* titles, tree, bytes */
		framesPane->Hide();
		frameScroll = new CScrollPane(itsWindow, this, kWinWidth, kFrameListH, 0, kStripHeight + kFrameHeader,
									  sizFIXEDLEFT, sizFIXEDTOP, FALSE, TRUE, FALSE);	/* the list, over it */
		frameList = new CFrameList(frameScroll, this, kWinWidth - 15, kFrameListH);
		frameScroll->InstallPanorama(frameList);
		frameScroll->Hide();
		toolsPane = new CToolsPane(itsWindow, this, kWinWidth, h, 0, kStripHeight);	/* under field and buttons */
		toolsPane->Hide();
		hostField = new CHostField(itsWindow, this, 250, 18, 18, kStripHeight + 14);
		hostField->Hide();
		pingBtn = new CLightButton(itsWindow, this, 64, 290, kStripHeight + 12, "Ping", cmdToolPing);
		pingBtn->Hide();
		dnsBtn = new CLightButton(itsWindow, this, 64, 362, kStripHeight + 12, "DNS", cmdToolDns);
		dnsBtn->Hide();
		traceBtn = new CLightButton(itsWindow, this, 72, 434, kStripHeight + 12, "Trace", cmdToolTrace);
		traceBtn->Hide();
	}
	listHeader = new CListHeader(itsWindow, this, kListWidth, 0, kStripHeight);
	listScroll = new CScrollPane(itsWindow, this, kListWidth,
								 kWinHeight - kStripHeight - kStatusHeight - kHeaderHeight, 0,
								 kStripHeight + kHeaderHeight, sizFIXEDLEFT, sizELASTIC, FALSE, TRUE, FALSE);
	hostList = new CHostList(listScroll, this, kListWidth - 15,
							 kWinHeight - kStripHeight - kStatusHeight - kHeaderHeight);
	listScroll->InstallPanorama(hostList);
	detail = new CDetailPane(itsWindow, this, kWinWidth - kListWidth,
							 kWinHeight - kStripHeight - kStatusHeight, kListWidth, kStripHeight);
	status = new CStatusBar(itsWindow, this, kWinWidth, 0, kWinHeight - kStatusHeight);

	itsGopher = this;		/* the menu commands go to the document, not to a pane */
}


void CMain::MakeWindowName(Str255 newName)
{
	itsWindow->GetTitle(newName);
}


void CMain::MakeNewContents()
{
	netOK = (Boolean) (NC_Init() == 0);
	if (netOK) LoadPrefs();								/* range, timeout, probes, ports */
	chore = new CNetChore;
	chore->itsMain = this;
	gApplication->AssignIdleChore(chore);
	stopBtn->SetActive(FALSE);
	exportBtn->SetActive(FALSE);
	copyBtn->SetActive(FALSE);
	if (!netOK) scanBtn->SetActive(FALSE);
	ShowStatus();
}

void CMain::ContentsToWindow()	{}
void CMain::WindowToContents()	{}


Boolean CMain::Close(Boolean quitting)
{
	if (chore != NULL) {
		gApplication->CancelIdleChore(chore);
		delete chore;
		chore = NULL;
	}
	NC_SweepStop();
	NC_Shutdown();
	netOK = FALSE;
	dirty = FALSE;			/* typing a host name is not a change to save: nothing here is a document */
	return x_CMain::Close(quitting);
}


/******************************************************************************
 Pump - one slice of engine work, from the idle chore

 ******************************************************************************/

void CMain::Pump(long *maxSleep)
{
	unsigned long now = TickCount();
	long act;

	if (NC_Listening()) NC_ListenIdle();
	if (toolMode != 0 && (NC_ToolState() == NC_TOOL_RESOLVING || NC_ToolState() == NC_TOOL_RUNNING))
		NC_ToolIdle();
	if (stage == 1) {
		if (NC_SweepIdle() == NC_SWEEP_DONE) {			/* the IP sweep is through: AppleTalk next */
			if (NC_ATAvailable()) { NC_NbpStart(); stage = 2; }
			else stage = 0;
		}
	} else if (stage == 2) {
		if (!NC_NbpIdle()) { stage = 0; if (view == kViewAT) atPane->Refresh(); }	/* else: the change count redraws */
	}
	act = NC_ActivityCount();
	if (act != lastActivity) {
		lastActivity = act;
		actLed->SetLit(TRUE);
		ledOff = now + 5;
	} else if (now > ledOff) actLed->SetLit(FALSE);

	if (NC_ChangeCount() != lastChange && now - lastDraw > 30) {	/* new results: at most twice a second */
		lastChange = NC_ChangeCount();
		lastDraw = now;
		if (view == kViewIP) {
			hostList->Update();
			detail->Refresh();
		} else if (view == kViewAT) atPane->Refresh();
		else if (view == kViewListen && NC_EventTotal() != lastEvents) {
			lastEvents = NC_EventTotal();
			listenPane->Refresh();
		}
	}
	if (view == kViewListen && NC_Listening()) {
		listenPane->Pulse();								/* the meter LEDs, every slice	*/
		if (now - lastDraw > 120) { lastDraw = now; listenPane->Refresh(); }	/* "s ago", packets */
	}
	if (view == kViewMap && NC_Listening() && now - lastDraw > 120) {	/* the map: redrawn every 2 s */
		lastDraw = now;
		mapPane->Update();									/* offscreen, then copied: no flicker */
	}
	if (view == kViewFrames && NC_Listening() && now - lastDraw > 60) {	/* the frame list: once a second */
		lastDraw = now;
		frameList->Update();
	}
	if (view == kViewTools && toolMode != 0) {
		long sig = NC_ToolLineCount() * 8L + NC_ToolState();
		if (sig != lastToolSig) { lastToolSig = sig; toolsPane->Refresh(); }
	}
	if (now - lastStatus > 15) {
		lastStatus = now;
		ShowStatus();
	}
	*maxSleep = Busy() ? 1 : 6;							/* sleep, but come back soon while busy */
}


static long gSelFrame = -1;							// the frame Frames' Copy copies, -1 none

	// What Export and Copy hand out in each view: Frames a pcap file and the selected frame, Listen and Map the
	// stations and events, AppleTalk the NBP entities, IP Network and Tools the sweep.
static long BuildViewReport(short aView, char *buf, long max)
{
	const NCFrame *f;
	if (aView == kViewFrames)
		return (gSelFrame >= 0 && (f = NC_Frame(gSelFrame)) != NULL) ? NC_FrameText(f, gSelFrame + 1, buf, max) : 0;
	if (aView == kViewListen || aView == kViewMap) return NC_BuildListenReport(buf, max);
	if (aView == kViewAT) return NC_BuildATReport(buf, max);
	return NC_BuildReport(buf, max);
}

static void ReportState(short aView, Boolean *canExport, Boolean *canCopy)
{
	if (aView == kViewFrames) {
		*canExport = (Boolean) (NC_FrameTotal() > 0);
		*canCopy = (Boolean) (gSelFrame >= 0 && NC_Frame(gSelFrame) != NULL);
	} else if (aView == kViewListen || aView == kViewMap) *canExport = *canCopy = (Boolean) (NC_StationCount() > 0);
	else if (aView == kViewAT) *canExport = *canCopy = (Boolean) (NC_EntityCount() > 0);
	else *canExport = *canCopy = (Boolean) (NC_HostCount() > 0);
}

void CMain::HostSelected(unsigned long anIP)
{
	detail->SetHost(anIP);
}

void CMain::FrameSelected(long aFrame)
{
	gSelFrame = aFrame;
	framesPane->SetFrame(aFrame);
	ShowStatus();											/* Copy follows the selection */
}


/******************************************************************************
 Scan control and the status bar

 ******************************************************************************/

Boolean CMain::Busy()
{
	short t = NC_ToolState();
	return (Boolean) (stage != 0 || NC_Listening() || (toolMode != 0 && (t == NC_TOOL_RESOLVING || t == NC_TOOL_RUNNING)));
}

void CMain::StartScan()
{
	if (!netOK || stage != 0 || NC_Listening()) return;
	if (view == kViewListen || view == kViewMap || view == kViewFrames) {	/* start hearing: a new capture */
		if (NC_ListenStart() != 0) SysBeep(1);
		frameList->Restart();
		framesPane->SetFrame(-1);
		gSelFrame = -1;
		if (view == kViewMap) mapPane->Refresh(); else if (view == kViewListen) listenPane->Refresh();
		ShowStatus();
		return;
	}
	if (view == kViewAT) {								/* AppleTalk: the NBP lookup alone */
		if (!NC_ATAvailable()) { SysBeep(1); return; }
		NC_NbpStart();
		stage = 2;
		ShowStatus();
		return;
	}
	NC_SweepStart();
	stage = 1;
	lastChange = -1;
	scanBtn->SetActive(FALSE);
	stopBtn->SetActive(TRUE);
	ShowStatus();
}

void CMain::StopScan()
{
	if (NC_Listening()) { NC_ListenStop(); listenPane->Refresh(); framesPane->Refresh(); }
	if (toolMode != 0) NC_ToolStop();
	if (stage != 0) { NC_SweepStop(); stage = 0; }
	ShowStatus();
}

void CMain::StartTool(short aMode)
{
	char host[128];
	if (!netOK) return;
	hostField->GetHost(host, sizeof(host));
	if (host[0] == '\0') { SysBeep(1); return; }
	NC_ToolStop();
	toolMode = aMode;
	toolsPane->SetMode(aMode);
	if (aMode == 1) NC_PingStart(host, 80, 4);
	else if (aMode == 2) NC_DnsStart(host);
	else NC_TraceStart(host);
	lastToolSig = -1;
	toolsPane->Refresh();
	hostField->SelectAll(TRUE);							/* the next host replaces this one */
	ShowStatus();
}

void CMain::ShowStatus()
{
	char s[96], c[64], ip[20];
	long done = 0, total = 0, services = 0;
	short i, n = NC_HostCount();
	Boolean idle = (Boolean) !Busy();

	for (i = 0; i < n; i++) services += CountBits(NC_Host(i)->openMask);
	s[0] = '\0';
	if (!netOK) CCat(s, "Open Transport TCP/IP is not available.");
	else if (stage == 1) {
		NC_SweepProgress(&done, &total);
		CCat(s, NC_SweepPhase() == NC_SWEEP_NAMING ? "Naming hosts on " : "Scanning ");
		NC_IPToStr(NC_Base(), ip); CCat(s, ip); CCat(s, "/24  ");
		CCatNum(s, done); CCat(s, "/"); CCatNum(s, total);
	} else if (stage == 2) {
		short d, t;
		NC_NbpProgress(&d, &t);
		done = d; total = t;
		CCat(s, "Looking up AppleTalk devices, echo, server status  "); CCatNum(s, d); CCat(s, "/"); CCatNum(s, t);
	} else if (NC_Listening()) {
		NCListenStats ls;
		NC_ListenGetStats(&ls);
		CCat(s, "Listening  "); CCatNum(s, ls.total); CCat(s, " frames from "); CCatNum(s, NC_StationCount());
		CCat(s, " stations");
	} else if (toolMode != 0 && (NC_ToolState() == NC_TOOL_RESOLVING || NC_ToolState() == NC_TOOL_RUNNING))
		CCat(s, toolMode == 1 ? "Ping running." : toolMode == 2 ? "Looking up the name." : "Traceroute running.");
	else if (view == kViewAT) CCat(s, "Ready - Scan looks up the AppleTalk devices, zone by zone.");
	else if (view == kViewListen) CCat(s, "Ready - Scan listens to the network; nothing is sent.");
	else if (view == kViewMap) CCat(s, "Ready - Scan listens and draws who sends to whom.");
	else if (view == kViewFrames) CCat(s, "Ready - Scan captures what reaches this Mac; nothing is sent.");
	else if (view == kViewTools) CCat(s, "Ready.");
	else if (n > 0) CCat(s, "Ready.");
	else CCat(s, "Ready - press Scan to sweep the local network.");

	c[0] = '\0';
	CCatNum(c, n); CCat(c, n == 1 ? " host  \xA5  " : " hosts  \xA5  ");
	CCatNum(c, services); CCat(c, services == 1 ? " service  \xA5  " : " services  \xA5  ");
	CCatNum(c, NC_EntityCount()); CCat(c, " AppleTalk");
	status->SetState(s, done, total, c);

	if (scanBtn != NULL) {
		scanBtn->SetActive((Boolean) (netOK && idle));
		stopBtn->SetActive((Boolean) !idle);
		Boolean canExport, canCopy;
		ReportState(view, &canExport, &canCopy);
		exportBtn->SetActive(canExport);
		copyBtn->SetActive(canCopy);
	}
	if (pingBtn != NULL) {								/* the running tool's button stays down */
		short t = NC_ToolState();
		short run = (short) ((t == NC_TOOL_RESOLVING || t == NC_TOOL_RUNNING) ? toolMode : 0);
		pingBtn->SetRunning((Boolean) (run == 1));
		dnsBtn->SetRunning((Boolean) (run == 2));
		traceBtn->SetRunning((Boolean) (run == 3));
	}
}


/******************************************************************************
 Views

 ******************************************************************************/

void CMain::SetView(short aView)
{
	if (aView < 0 || aView >= kViewCount) return;
	view = aView;
	tabs->SetCurrent(aView);
	listHeader->Hide(); listScroll->Hide(); detail->Hide();
	atScroll->Hide(); listenPane->Hide(); mapPane->Hide(); framesPane->Hide(); frameScroll->Hide();
	toolsPane->Hide(); hostField->Hide(); pingBtn->Hide(); dnsBtn->Hide(); traceBtn->Hide();
	if (aView == kViewIP) {
		listHeader->Show(); listScroll->Show(); detail->Show();
		hostList->Update();
	} else if (aView == kViewAT) atScroll->Show();
	else if (aView == kViewListen) listenPane->Show();
	else if (aView == kViewMap) mapPane->Show();
	else if (aView == kViewFrames) { framesPane->Show(); frameScroll->Show(); frameList->Update(); }
	else {
		toolsPane->Show(); hostField->Show(); pingBtn->Show(); dnsBtn->Show(); traceBtn->Show();
	}
	if (aView == kViewTools) {							/* typing goes to the host field */
		itsGopher = hostField;
		hostField->BecomeGopher(TRUE);
		hostField->SelectAll(TRUE);
	} else {
		itsGopher = this;
		BecomeGopher(TRUE);
	}
	{													/* repaint the whole view area	*/
		GrafPtr port = (GrafPtr) itsWindow->GetMacPort();
		SetPort(port);
		InvalRect(&port->portRect);
	}
	ShowStatus();
}


/******************************************************************************
 Report: Copy and Export (tab-delimited text, CR line ends)

 ******************************************************************************/

void CMain::CopyReport()
{
	Ptr buf = NewPtr(kReportMax);
	long n;
	if (buf == NULL) { SysBeep(1); return; }
	n = BuildViewReport(view, buf, kReportMax);
	if (n == 0) { SysBeep(1); DisposePtr(buf); return; }
	ZeroScrap();
	PutScrap(n, 'TEXT', buf);
	DisposePtr(buf);
}

void CMain::ExportReport()
{
	StandardFileReply reply;
	Ptr buf;
	long n;
	short ref;
	OSErr err;

	StandardPutFile("\pSave the report as:", view == kViewListen || view == kViewMap ? "\pMacNetScan Listen" :
					view == kViewAT ? "\pMacNetScan AppleTalk" : "\pMacNetScan Report", &reply);
	if (!reply.sfGood) return;
	buf = NewPtr(kReportMax);
	if (buf == NULL) { SysBeep(1); return; }
	n = BuildViewReport(view, buf, kReportMax);
	err = FSpCreate(&reply.sfFile, 'ttxt', 'TEXT', reply.sfScript);
	if (err == dupFNErr) err = noErr;
	if (err == noErr) err = FSpOpenDF(&reply.sfFile, fsRdWrPerm, &ref);
	if (err == noErr) {
		SetEOF(ref, 0);
		FSWrite(ref, &n, buf);
		FSClose(ref);
	}
	if (err != noErr) SysBeep(1);
	DisposePtr(buf);
}

void CMain::ExportFrames()								// the frames kept, oldest first, for Wireshark
{
	StandardFileReply reply;
	unsigned char rec[NC_PCAPREC];
	long total = NC_FrameTotal(), i, n;
	short ref;
	OSErr err;

	StandardPutFile("\pSave pcap for Wireshark as:", "\pMacNetScan.pcap", &reply);
	if (!reply.sfGood) return;
	err = FSpCreate(&reply.sfFile, 0x3F3F3F3FL, 'BINA', reply.sfScript);	/* creator: four question marks; as a literal two of them and the quote make a trigraph */
	if (err == dupFNErr) err = noErr;
	if (err == noErr) err = FSpOpenDF(&reply.sfFile, fsRdWrPerm, &ref);
	if (err == noErr) {
		SetEOF(ref, 0);
		n = NC_PcapHeader(rec);
		err = FSWrite(ref, &n, rec);
		for (i = total > NC_MAXFRAMES ? total - NC_MAXFRAMES : 0; err == noErr && i < total; i++) {
			const NCFrame *f = NC_Frame(i);
			if (f == NULL) continue;							/* overwritten while we wrote */
			n = NC_PcapRecord(f, rec);
			err = FSWrite(ref, &n, rec);
		}
		FSClose(ref);
	}
	if (err != noErr) SysBeep(1);
}


/******************************************************************************
 DoCommand / UpdateMenus

 ******************************************************************************/

void CMain::DoCommand(long theCommand)

{
	switch (theCommand) {
		case cmdScanStart:	StartScan(); break;
		case cmdScanStop:	StopScan(); break;
		case cmdExport:		if (view == kViewFrames) ExportFrames(); else ExportReport(); break;
		case cmdCopyReport:	CopyReport(); break;
		case cmdOptions:	if (!Busy() && RunOptions()) { hostList->Update(); listHeader->Refresh(); ShowStatus(); } break;
		case cmdViewIP:
		case cmdViewAT:
		case cmdViewListen:
		case cmdViewTools:
		case cmdViewMap:
		case cmdViewFrames:	SetView((short) (theCommand - cmdViewIP)); break;
		case cmdToolPing:	StartTool(1); break;
		case cmdToolDns:	StartTool(2); break;
		case cmdToolTrace:	StartTool(3); break;
		default:			x_CMain::DoCommand(theCommand); break;
	}
}


void CMain::UpdateMenus()

{
	short i;
	x_CMain::UpdateMenus();
	if (netOK && !Busy()) gBartender->EnableCmd(cmdScanStart);
	if (Busy()) gBartender->EnableCmd(cmdScanStop);
	else gBartender->EnableCmd(cmdOptions);
	{
		Boolean canExport, canCopy;
		ReportState(view, &canExport, &canCopy);
		if (canExport) gBartender->EnableCmd(cmdExport);
		if (canCopy) gBartender->EnableCmd(cmdCopyReport);
	}
	for (i = 0; i < kViewCount; i++) {
		gBartender->EnableCmd(cmdViewIP + i);
		gBartender->CheckMarkCmd(cmdViewIP + i, (Boolean) (i == view));
	}
}
